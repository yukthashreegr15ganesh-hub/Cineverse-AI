# CINEVERSE AI - Backend Environment Configuration

# Application settings
APP_NAME=Cineverse AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset Path (relative to backend directory or absolute)
DATASET_PATH=data/sample_movies.csv

# SQLite Watchlist Database Path
DATABASE_PATH=data/watchlist.db

# Optional TMDB API key for real-time live metadata and images
# If omitted or empty, the application seamlessly runs on the local curated dataset
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
